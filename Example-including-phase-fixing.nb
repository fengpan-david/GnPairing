      "Physics", " ", "Communications"}]}],
    FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "  ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"F", ".", " ", "Pan"}], "  ", "et", " ", "al"}], ",", " ", 
