Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "p", ",", "p0", ",", "n", ",", "en", ",", "rho2", ",", "Acore", ",", "g", 
   ",", "kMax"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p0", "=", "32"}], ";"}], "    ", 
  RowBox[{"(*", 
