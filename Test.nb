   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j2", "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rho2", "[", "3", "]"}], "=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"j3", "+", 
       RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Acore", "=", "40"}], ";", 
   RowBox[{
    RowBox[{"g", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"g", "[", "k", "]"}], "=", 
     RowBox[{"N", "[", 
      RowBox[{"1", ",", "p0"}], "]"}]}]}], ";", "  ", 
   RowBox[{"(*", 
    RowBox[{"*", " ", "pairing", " ", "strength", " ", "G"}], " ", "**)"}], 
   "             ", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Number of particle pairs is........\>\"", ",", 
     RowBox[{"kMax", "=", 
      RowBox[{
       RowBox[{"2", 
