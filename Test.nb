Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "=", "2"}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"Number", " ", "of", " ", "orbits"}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Number", " ", "of", " ", "nucleon", " ", "pairs"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"*", " ", 
        StyleBox["Input",
         FontSize->18,
         FontWeight->"Bold",
         FontColor->GrayLevel[0]], 
        StyleBox[" ",
         FontSize->18,
         FontWeight->"Bold",
         FontColor->GrayLevel[0]], 
        StyleBox["Quasispins",
         FontSize->18,
         FontWeight->"Bold",
         FontColor->GrayLevel[0]]}], 
       StyleBox[" ",
        FontSize->18,
        FontWeight->"Bold",
        FontColor->GrayLevel[0]], "**)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"j1", "=", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"j2", "=", 
         RowBox[{"3", "/", "2"}]}]}], "}"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"S", "[", "1", "]"}], "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j1", "+", 
            RowBox[{"1", "/", "2"}]}], ")"}], "/", "2"}]}], ",", 
        RowBox[{
         RowBox[{"S", "[", "2", "]"}], "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j2", "+", 
            RowBox[{"1", "/", "2"}]}], ")"}], "/", "2"}]}]}], "}"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"epsilon", "[", "i", "]"}], "=", "i"}], ",", 
        RowBox[{"{", 
