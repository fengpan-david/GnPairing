 RowBox[{"Clear", "[", 
  RowBox[{
  "p", ",", "p0", ",", "n", ",", "en", ",", "rho2", ",", "Acore", ",", "g", 
   ",", "kMax"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p0", "=", "32"}], ";"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"*", " ", "precision"}], " ", "**)"}], 
  "                                                                           \
                                                                "}], "\
\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"n", "=", "3"}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"*", " ", "number", " ", "of", " ", "energy", " ", "levels"}], 
    " ", "**)"}], 
   "                                                                          \
                                                                  ", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"en", "[", "i", "]"}], "=", "i"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"*", " ", "single"}], "-", 
     RowBox[{"particle", " ", "energies"}]}], " ", "**)"}], " ", 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"j1", "=", 
     RowBox[{"5", "/", "2"}]}], ",", 
    RowBox[{"j2", "=", 
     RowBox[{"7", "/", "2"}]}], ",", 
    RowBox[{"j3", "=", 
     RowBox[{"9", "/", "2"}]}]}], "}"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho2", "[", "1", "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j1", "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho2", "[", "2", "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j2", "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rho2", "[", "3", "]"}], "=", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{"j3", "+", 
       RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Acore", "=", "40"}], ";", 
   RowBox[{
    RowBox[{"g", "[", "k_", "]"}], ":=", 
    RowBox[{
     RowBox[{"g", "[", "k", "]"}], "=", 
     RowBox[{"N", "[", 
      RowBox[{"1", ",", "p0"}], "]"}]}]}], ";", "  ", 
   RowBox[{"(*", 
    RowBox[{"*", " ", "pairing", " ", "strength", " ", "G"}], " ", "**)"}], 
   "             ", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Number of particle pairs is........\>\"", ",", 
     RowBox[{"kMax", "=", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"S", "[", "i", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}], "-", 
       "1"}]}]}], "]"}], "        ", ";", "    ", 
   RowBox[{"(*", 
    RowBox[{"*", "kMax", " ", "number", " ", "of", " ", "pairs"}], "**)"}], 
   "     ", 
   StyleBox["\[IndentingNewLine]",
    FontColor->RGBColor[1, 0, 0]], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"*", " ", "calculations", " ", 
      RowBox[{"(", 
       RowBox[{"Newton", "-", "Raphson"}], ")"}], 
      StyleBox["2000",
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox[" ",
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox["initial",
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox[" ",
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox["guesses",
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox[" ",
       FontColor->RGBColor[1, 0, 0]], 
      StyleBox[
       RowBox[{"(", "NR2000", ")"}],
       FontColor->RGBColor[1, 0, 0]]}], 
     StyleBox[":",
      FontColor->RGBColor[1, 0, 0]]}], 
    StyleBox[" ",
     FontColor->RGBColor[1, 0, 0]], 
    StyleBox["**)",
     FontColor->RGBColor[1, 0, 0]]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "method", "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", "5"}], ",", 
         RowBox[{"zeroP", "=", "6"}], ",", 
         RowBox[{"nev", "=", "10"}], ",", 
         RowBox[{"methodHS", "=", 
          StyleBox["NR",
           FontColor->RGBColor[1, 0, 0]]}], ",", 
         RowBox[{"iterMC", "=", 
          StyleBox["2000",
           FontColor->RGBColor[1, 0, 0]]}], 
         StyleBox[",",
          FontColor->RGBColor[1, 0, 0]], 
         RowBox[{"iterNR", "=", "100"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"method", "=", 
         RowBox[{"{", 
          RowBox[{"methodHS", ",", "iterMC", ",", "iterNR"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<# pairs\>\"", ",", "\"\<t[s]\>\"", ",", "\"\<# solutions\>\"", 
           ",", "\"\<lowest energies [MeV]\>\""}], "}"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", "=", "1"}], ",", 
          RowBox[{"k", "\[LessEqual]", " ", "kMax"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{"EnergiesExactPairingHS", "[", 
             RowBox[{
              RowBox[{"g", "[", "k", "]"}], ",", "n", ",", "k", ",", "rho2", 
              ",", "en", ",", "nev", ",", "p", ",", "zeroP", ",", "method"}], 
             "]"}], "]"}], ";", 
           RowBox[{"k", "++"}]}]}], "]"}]}]}], "]"}]}], 
    "                              ", "]"}]}]}]}], "Input",
