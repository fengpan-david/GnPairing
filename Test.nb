     RowBox[{"3", "/", "2"}]}], ",", 
    RowBox[{"j2", "=", 
     RowBox[{"7", "/", "2"}]}], ",", 
    RowBox[{"j3", "=", 
     RowBox[{"11", "/", "2"}]}]}], "}"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho2", "[", "1", "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"j1", "+", 
      RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
