     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GnPairing", "[", 
      RowBox[{
      "p_", ",", "k_", ",", "S_Symbol", ",", "epsilon_Symbol", ",", 
