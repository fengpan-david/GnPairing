  "                                                                           \
                                                                "}], "\
\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"n", "=", "3"}], ";", "      ", 
   RowBox[{"(*", 
    RowBox[{"*", " ", "number", " ", "of", " ", "energy", " ", "levels"}], 
    " ", "**)"}], 
   "                                                                          \
                                                                  ", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"en", "[", "i", "]"}], "=", "i"}], ",", 
