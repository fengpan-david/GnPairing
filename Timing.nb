    FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", " ", 
  RowBox[{"(*", " ", 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"F", ".", " ", "Pan"}], "  ", "et", " ", "al"}], ",", " ", 
     RowBox[{"May", " ", "22"}], ",", " ", "2026", ",", " ", 
     RowBox[{
     "a", " ", "simple", " ", "Lanczos", " ", "for", " ", "evaluating", " ", 
