          RowBox[{"Norm", "[", "w", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"m", "=", "j"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Build", " ", "tridiagonal", " ", "matrix"}], "*)"}], 
      RowBox[{"T", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Band", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}], "]"}], "\[Rule]", 
